# 窥岛 server 环境变量 —— 复制为 .env，填你有的 key（不必四个都填）
# 运行：node --env-file=.env index.js   （Node 20.6+ 原生支持，无需 dotenv）

# 默认启动用哪个引擎；不填则自动选第一个有 key 的。运行时也能在 UI ⚙️ 里热切换。
# 可选：claude | deepseek | kimi | gemini
AI_PROVIDER=deepseek

# —— 各家 key ——
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=          # Kimi（月之暗面）。也可用 KIMI_API_KEY
GEMINI_API_KEY=

# —— 可选：覆盖默认模型 ——
# CLAUDE_MODEL=claude-sonnet-4-6
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_MODEL=moonshot-v1-8k        # 想要更强可换 kimi-latest 或 kimi-k2-0711-preview
# GEMINI_MODEL=gemini-2.0-flash

# —— 玩法参数 ——
DAILY_QUOTA=5              # 每角色每日真实 AI 上限，超出走脚本托底。测心跳时可临时调大（如 999）
CATCHUP_HOURS=4           # 离岛多久触发离岛报告
